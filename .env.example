# ---- Client (read by Vite at BUILD time; never put secrets here) ----
# Full WebSocket URL of the room server. Leave unset when the room server
# also serves the built client (one origin) — the client then uses /ws on
# its own origin, which is what `npm start` gives you.
# VITE_WS_URL=wss://rooms.example.com/ws
# Cookie-free usage counting in the Plausible event format (src/telemetry.ts).
# Unset = no counting. Also set CONNECT_SRC on the server to the same origin.
# VITE_ANALYTICS_URL=https://plausible.io/api/event
# VITE_ANALYTICS_DOMAIN=crackthecode.example
# Shown on the privacy and terms pages as the way to reach you.
# VITE_CONTACT_EMAIL=hello@crackthecode.example
# The build's version, sent with crash reports (e.g. the commit hash).
# VITE_VERSION=1.1.0

# ---- Server (read by `npm start` at RUN time) ----
# PORT=8787
# HOST=0.0.0.0
# Extra origins allowed to open a game socket, comma-separated. Leave UNSET
# for the normal deploy (one service serving page + socket): the server then
# accepts only its own page. Needed only when the page is hosted elsewhere.
# "*" accepts any origin (not recommended).
# ALLOWED_ORIGINS=https://your-static-site.example
# How long a dropped player's seat (and secret) is held, in ms.
# SEAT_GRACE_MS=180000
# MAX_ROOMS=5000
# STATIC_DIR=dist
# Read the player's address from X-Forwarded-For (on by default on Render).
# TRUST_PROXY=1
# Open sockets per address, and wrong table codes per address per 10 minutes.
# MAX_SOCKETS_PER_IP=12
# JOIN_FAILS_PER_IP=20
# /healthz?key=<this> also shows how many tables and sockets are open.
# HEALTH_KEY=some-long-random-string
# Extra addresses the page may connect to (analytics, a separate room server).
# CONNECT_SRC=https://plausible.io
