# ---- Client (read by Vite at BUILD time; never put secrets here) ----
# Full WebSocket URL of the room server. Leave unset when the room server
# also serves the built client (one origin) — the client then uses /ws on
# its own origin, which is what `npm start` gives you.
# VITE_WS_URL=wss://rooms.example.com/ws

# ---- Server (read by `npm start` at RUN time) ----
# PORT=8787
# HOST=0.0.0.0
# Extra origins allowed to open a game socket, comma-separated. Leave UNSET
# for the normal deploy (one service serving page + socket): the server then
# accepts only its own page. Needed only when the page is hosted elsewhere.
# "*" accepts any origin (not recommended).
# ALLOWED_ORIGINS=https://your-static-site.example
# How long a dropped player's seat (and secret) is held, in ms.
# SEAT_GRACE_MS=180000
# MAX_ROOMS=5000
# STATIC_DIR=dist
